+/* Cover (zoom-to-fill) instead of contain: scale until BOTH axes are covered
+ * and let the overflow crop. For 4:3 content in a wider window this removes the
+ * pillarbox at the cost of the top and bottom of the source. */
+static void letterbox_rect_aspect_fill(int ww, int wh, int num, int den,
+                                       int *x, int *y, int *w, int *h) {
+    int dw = ww, dh = (ww * den) / num;
+    if (dh < wh) { dh = wh; dw = (wh * num) / den; }
+    *x = (ww - dw) / 2;
+    *y = (wh - dh) / 2;
+    *w = dw; *h = dh;
+}
+
+/* FMV fill: 4:3-pinned frames (FMV/boot) cover the window rather than
+ * pillarboxing, cropping top and bottom instead of showing bars. */
+static void pinned_rect_4_3(int ww, int wh, int *x, int *y, int *w, int *h) {
+    letterbox_rect_aspect_fill(ww, wh, 4, 3, x, y, w, h);
+}
