+/* Rows that have ever shown picture in this video. VRAM coverage can't see a
+ * letterbox baked into the MDEC stream, but such a row is never lit, while dark
+ * content eventually is — so this converges downward and never oscillates. */
+static uint64_t s_evl[32];
+static int s_evl_h = -1, s_evl_top = -1, s_evl_bot = -1, s_evl_black = 0;
+/* Never crop more than this per side, so a frame that is still black doesn't
+ * zoom absurdly. Above O.D.T.'s largest real letterbox (40 of 236 = 17%). */
+#define FMV_MAX_BAR_PCT 20
+/* The bar edge is an MDEC block boundary, so the last row or two of "picture"
+ * is a dark transition. Trim a couple of rows past it - unnoticeable at 236. */
+#define FMV_BAR_MARGIN 2
+
+static void fmv_accumulate(const uint32_t *px, int w, int h) {
+    if (!px || w <= 0 || h <= 0 || h > 2048) return;
+    if (h != s_evl_h) {
+        memset(s_evl, 0, sizeof s_evl);
+        s_evl_h = h; s_evl_top = s_evl_bot = -1;
+    }
+    int x, y, peak = 0;
+    for (y = 0; y < h; y += 4)
+        for (x = 0; x < w; x += 8) {
+            uint32_t c = px[(size_t)y * w + x];
+            uint32_t r = (c >> 16) & 0xFF, g = (c >> 8) & 0xFF, b = c & 0xFF;
+            uint32_t m = r > g ? (r > b ? r : b) : (g > b ? g : b);
+            if ((int)m > peak) peak = (int)m;
+        }
+    /* A run of black frames is the gap between videos: start a fresh map. The
+     * crop in force stays until the next lit frame, which is invisible here. */
+    if (peak <= 8) {
+        if (++s_evl_black >= 4) { memset(s_evl, 0, sizeof s_evl); s_evl_black = 0; }
+        return;
+    }
+    s_evl_black = 0;
+    /* Measured on ODT's movies: at a floor of 8 a letterbox row has zero lit
+     * pixels while picture rows are saturated. Lower catches MDEC ringing in
+     * the bars, higher discards genuinely dark picture. */
+    const int need = (w / 4) / 8 + 2;
+    for (y = 0; y < h; y++) {
+        if ((s_evl[y >> 6] >> (y & 63)) & 1ull) continue;
+        int nlit = 0;
+        for (x = 0; x < w; x += 4) {
+            uint32_t c = px[(size_t)y * w + x];
+            uint32_t r = (c >> 16) & 0xFF, g = (c >> 8) & 0xFF, b = c & 0xFF;
+            uint32_t m = r > g ? (r > b ? r : b) : (g > b ? g : b);
+            if ((int)m > 8 && ++nlit >= need) {
+                s_evl[y >> 6] |= 1ull << (y & 63); break;
+            }
+        }
+    }
+    int first = -1, last = -1;
+    for (y = 0; y < h; y++)
+        if ((s_evl[y >> 6] >> (y & 63)) & 1ull) { if (first < 0) first = y; last = y; }
+    /* The estimate is never smaller than the real letterbox: a bar row never
+     * lights, and the map only grows, so it shrinks toward the truth from
+     * above. Applying it every frame therefore cannot show a bar - only a
+     * slight over-crop while the picture is still fading up from black. */
+    const int cap = h * FMV_MAX_BAR_PCT / 100;
+    int t = first < 0 ? cap : first;
+    int b = first < 0 ? cap : h - 1 - last;
+    if (first >= 0) {
+        if (t > 0) t += FMV_BAR_MARGIN;
+        if (b > 0) b += FMV_BAR_MARGIN;
+    }
+    s_evl_top = t > cap ? cap : t;
+    s_evl_bot = b > cap ? cap : b;
+}
+
+/* Cover the window with the CONTENT region, then express that as the rect for
+ * the whole source so the black rows fall outside the viewport. */
+static void fmv_content_fill_rect(int ww, int wh, int src_h, int top, int bot,
+                                  int *lx, int *ly, int *lw, int *lh) {
+    if (top < 0 || bot < 0 || top + bot >= src_h) return;
+    int content_h = src_h - top - bot;
+    if (content_h <= 0) return;
+    /* Content display aspect: 4:3 widened by the fraction of field it uses. */
+    int cw = ww;
+    int ch = (ww * 3 * content_h) / (4 * src_h);
+    if (ch < wh) { ch = wh; cw = (wh * 4 * src_h) / (3 * content_h); }
+    *lw = cw;
+    /* Round scale and offset away from zero. Truncating either leaves the
+     * content's bottom edge a fraction of a pixel high, showing a 1px sliver. */
+    *lh = (ch * src_h + content_h - 1) / content_h;
+    *lx = (ww - cw) / 2;
+    /* glViewport is bottom-left origin: source row 0 sits at ly+lh and row
+     * src_h at ly, so the content's BOTTOM edge is what anchors ly. */
+    *ly = (wh - ch) / 2 - (bot * ch + content_h - 1) / content_h;
+}
