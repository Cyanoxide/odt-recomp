+/* GP1(07h) vertical position relative to TV centre, in window pixels.
+ * Games shake the screen by alternating y1 per frame; presenting every band
+ * centred throws that away, so carry the offset into the present rect. */
+static int present_voffset_px(int src_h, int lh) {
+    if (src_h <= 0 || lh <= 0) return 0;
+    GpuDisplayInfo di;
+    gpu_get_display_info(&di);
+    return (di.screen_offset_y * lh) / src_h;
+}
