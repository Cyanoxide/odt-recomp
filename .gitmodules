[submodule "psxrecomp"]
	path = psxrecomp
	url = https://github.com/mstan/psxrecomp.git
	branch = master
	# Local patches (see patches/) leave the tree permanently dirty.
	ignore = dirty
[submodule "recomp-ui"]
	path = recomp-ui
	url = https://github.com/RetroPortingToolKit/recomp-ui.git
	branch = master
